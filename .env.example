# --- Base de données -------------------------------------------------------
# Production : URL PostgreSQL (Neon, Supabase, Vercel Postgres, Railway...).
# Laissez vide en local : une base PostgreSQL embarquée (PGlite) est créée dans .data/
DATABASE_URL=

# --- Application -----------------------------------------------------------
# URL publique du site (liens de partage de la Ship Card, invitations)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Taille maximale d'une archive ZIP en Mo (Vercel limite le corps des requêtes à 4,5 Mo)
MAX_ZIP_MB=4
